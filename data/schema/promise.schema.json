{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Promise Entry",
  "type": "object",
  "required": ["id", "person", "campaign", "promise_text", "source_url", "category", "status", "status_history"],
  "properties": {
    "id": { "type": "string" },
    "person": { "type": "string" },
    "campaign": { "type": "string" },
    "promise_text": { "type": "string", "minLength": 1 },
    "date_made": { "type": ["string", "null"], "format": "date" },
    "date_made_note": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "category": { "type": "string" },
    "status": {
      "enum": [
        "not_yet_rated",
        "in_the_works",
        "stalled",
        "compromise",
        "promise_kept",
        "promise_broken",
        "flagged_not_atomic"
      ]
    },
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["status", "date", "note"],
        "properties": {
          "status": {
            "enum": [
              "not_yet_rated",
              "in_the_works",
              "stalled",
              "compromise",
              "promise_kept",
              "promise_broken",
              "flagged_not_atomic"
            ]
          },
          "date": { "type": "string", "format": "date" },
          "note": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
